<?xml version="1.0" encoding="utf-8"?>
<!-- installLocation="auto" lets the app (and its saved photos) live on the TV's USB stick. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="SOL"
        android:allowBackup="false">

        <service
            android:name=".SolDream"
            android:exported="true"
            android:label="SOL nail art"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Not on the home screen: started over ADB to preview the slideshow or force a photo refresh. -->
        <activity
            android:name=".PreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
    </application>
</manifest>
